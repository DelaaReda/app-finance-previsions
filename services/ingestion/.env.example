# Environment variables for Ingestion Service

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=60

# Yahoo Finance symbols to track
YAHOO_SYMBOLS=SPY,QQQ,AAPL,MSFT,GOOGL

# RSS feeds to monitor
RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://rss.cnn.com/rss/edition.rss

# FRED series to track (requires API key from https://fred.stlouisfed.org/)
FRED_SERIES=GDP,CPIAUCSL,UNRATE
FRED_API_KEY=your_fred_api_key_here