# 🌐 Environment Configuration for Finance Copilot
# ⚠️ NE JAMAIS COMMITER CE FICHIER AVEC DE VRAIES CLÉS
# Copiez ce fichier vers .env et remplissez avec vos vraies clés

# === CORE API CONFIGURATION ===
API_HOST=127.0.0.1
API_PORT=8050
API_ENV=development
FINANCE_BASE_DIR=..

# === DATA SOURCES ===
# FRED API (Federal Reserve Economic Data)
# Obtenir clé: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=votre_cle_fred_ici

# Yahoo Finance
AF_ALLOW_INTERNET=1

# Third-party API keys (remplacer par vos clés)
FIRECRAWL_API_KEY=fc-votre_cle_ici
SERPER_API_KEY=votre_cle_ici
TAVILY_API_KEY=tvly-dev-votre_cle_ici
OPEN_ROUTER_API_KEY=sk-or-v1-votre_cle_ici
CODESTRAL_API_KEY=votre_cle_ici
GROK_API_KEY=gsk_votre_cle_ici
MASSIVE_API_KEY=votre_cle_ici

# Default LLM policy (g4f first by default)
LLM_SETTINGS_FILE=configs/llm-models.json
LLM_MODEL_MODE=best
# Optional override to force fastest mode when no explicit mode is provided
LLM_FASTEST_MODE=0
LLM_G4F_PROVIDER=DeepInfra
LLM_G4F_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
LLM_SUMMARY_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
LLM_JUDGE_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
G4F_PROVIDER=DeepInfra
G4F_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
LLM_DEV_MODELS=qwen-3-235b,qwen/qwen3-235b-a22b,deepseek-v3,deepseek/deepseek-v3
LLM_FASTEST_MODELS=qwen-3-235b,deepseek-v3,qwen/qwen3-235b-a22b,deepseek/deepseek-v3
LLM_DEV_TIMEOUT_SECONDS=20
LLM_FASTEST_TIMEOUT_SECONDS=12
LLM_BEST_TIMEOUT_SECONDS=60
LLM_DEV_MAX_ATTEMPTS=2
LLM_FASTEST_MAX_ATTEMPTS=2
LLM_BEST_MAX_ATTEMPTS=3
# Per-endpoint override example:
# LLM_JUDGE_MODE=fastest
# Legacy compatibility:
# JUDGE_LLM_MODE=fastest

# Judge timeout tuning (template defaults)
JUDGE_ROW_TIMEOUT_SECONDS=35
JUDGE_ANALYZE_TIMEOUT_SECONDS=45
JUDGE_G4F_TIMEOUT_SECONDS=60
JUDGE_ANALYZE_TIMEOUT_SECONDS_FASTEST=10
JUDGE_G4F_TIMEOUT_SECONDS_FASTEST=12
JUDGE_FASTEST_SKIP_ECON_AGENT=1
JUDGE_FASTEST_DISABLE_PAID_FALLBACKS=1
JUDGE_FASTEST_SKIP_JSON_REPAIR=1
JUDGE_ALLOW_DEBUG_FULL=0
# Optional: if set, /api/judge?debug_full=true also requires header X-Debug-Token to match
JUDGE_DEBUG_ADMIN_TOKEN=

# === DATABASE & STORAGE ===
DATABASE_URL=sqlite:///data/rag/rag_database.db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24

# === SECURITY ===
# ⚠️ Générer une clé unique pour la production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changer-cette-cle-en-production

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === RATE LIMITING ===
RATE_LIMIT_COPILOT=10/minute
RATE_LIMIT_BRIEF=30/hour
RATE_LIMIT_NEWS=100/hour

# === THIRD-PARTY SERVICES ===
FINNHUB_API_KEY=votre_cle_ici
NEWSAPI_ORG_KEY=votre_cle_ici

# === LOGGING & MONITORING ===
LOG_LEVEL=INFO
LOGURU_LEVEL=INFO
LOGURU_SINK=logs/api.log
SENTRY_DSN=votre_sentry_dsn_ici
SENTRY_AUTH_TOKEN=votre_token_ici
SENTRY_SEND_DEFAULT_PII=true
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_PROFILE_LIFECYCLE=trace

# === PERFORMANCE OPTIMIZATION ===
DOWNSAMPLE_THRESHOLD_POINTS=1000
RAG_NEWS_RETENTION_DAYS=730
RAG_FACTS_RETENTION_DAYS=1825

# === DEVELOPMENT ===
DEBUG=false
RELOAD=true

# === PRODUCTION ===
WORKERS=4
TIMEOUT_KEEP_ALIVE=5

# === BACKUP & MAINTENANCE ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# === FEATURE FLAGS ===
FEATURE_NEWS_INGESTION=true
FEATURE_RAG_ENRICHMENT=true
FEATURE_LLM_COPILOT=true
FEATURE_BACKTESTING=false

# === QUALITY CONTROL ===
NEWS_FRESHNESS_TARGET_MINUTES=10
DATA_COVERAGE_TARGET_PERCENT=90

# === TESTING ===
TEST_DATABASE_URL=sqlite:///:memory:
TEST_API_TIMEOUT=30

# === MISC ===
USER_AGENT="FinanceCopilot/1.0"
TZ=UTC

# === ECON LLM AGENT MODE ===
ECON_AGENT_MODE=prod
