            "mimeType": "text/javascript",
            "text": "import { apiGet } from \"/src/api/client.ts\";\nexport const macroService = {\n  /**\n   * Get macro time series data\n   */\n  getSeries: async (seriesIds, limit = 200) => {\n    const params = { limit: String(limit) };\n    if (seriesIds) params.series_ids = seriesIds;\n    return apiGet(\"/macro/series\", params);\n  },\n  /**\n   * Get current macro snapshot (latest values)\n   */\n  getSnapshot: async () => {\n    return apiGet(\"/macro/snapshot\");\n  },\n  /**\n   * Get macro indicators with trend analysis\n   */\n  getIndicators: async () => {\n    return apiGet(\"/macro/indicators\");\n  }\n};\nexport const fetchMacroSeries = async (seriesIds, start) => {\n  const seriesIdsParam = seriesIds.join(\",\");\n  const params = { series_ids: seriesIdsParam };\n  if (start) params.start = start;\n  return macroService.getSeries(seriesIdsParam);\n};\n\n//# sourceMappingURL=data:application/json;base64,"
