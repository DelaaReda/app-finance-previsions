            "mimeType": "text/javascript",
            "text": "import { useQuery } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=8017dbba\";\nimport { briefService } from \"/src/services/index.ts\";\nexport function useBriefs(filters) {\n  return useQuery({\n    queryKey: [\"briefs\", \"list\", filters],\n    queryFn: () => briefService.getBriefs(filters),\n    staleTime: 15 * 60 * 1e3\n    // 15 minutes\n  });\n}\nexport function useBrief(id) {\n  return useQuery({\n    queryKey: [\"briefs\", \"detail\", id],\n    queryFn: () => briefService.getBrief(id),\n    enabled: !!id,\n    staleTime: 30 * 60 * 1e3\n  });\n}\nexport function useLatestBrief(type = \"daily\", universe = [\"SPY\", \"QQQ\"]) {\n  return useQuery({\n    queryKey: [\"briefs\", \"latest\", type, universe],\n    queryFn: () => briefService.getLatest(type, universe),\n    staleTime: 5 * 60 * 1e3\n  });\n}\n\n//# sourceMappingURL=data:application/json;base64,"
