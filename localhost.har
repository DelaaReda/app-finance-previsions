            "text": "import { useQuery } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=8017dbba\";\nimport { stocksService } from \"/src/services/index.ts\";\nexport function useStockAnalysis(ticker) {\n  return useQuery({\n    queryKey: [\"stocks\", ticker, \"analysis\"],\n    queryFn: () => stocksService.getAnalysis(ticker),\n    enabled: !!ticker,\n    staleTime: 5 * 60 * 1e3\n    // 5 minutes\n  });\n}\nexport function useTechnicalIndicators(ticker) {\n  return useQuery({\n    queryKey: [\"stocks\", ticker, \"technical\"],\n    queryFn: async () => {\n      const detail = await stocksService.getTickerDetail(ticker);\n      return detail;\n    },\n    enabled: !!ticker,\n    staleTime: 5 * 60 * 1e3\n  });\n}\n\n//# sourceMappingURL=data:application/json;base64,"
