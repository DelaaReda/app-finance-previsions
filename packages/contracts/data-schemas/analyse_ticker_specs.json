{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schema/equity_snapshot.json",
  "title": "EquitySnapshot",
  "type": "object",
  "required": ["meta", "instrument", "company"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["snapshot_ts", "profile", "source_system"],
      "properties": {
        "snapshot_ts": {
          "type": "string",
          "format": "date-time"
        },
        "profile": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "trading_session_state": {
          "type": "string",
          "enum": ["pre_market", "regular", "after_hours", "holiday"]
        },
        "event_context": {
          "type": "object",
          "properties": {
            "pre_earnings": { "type": "boolean" },
            "post_earnings": { "type": "boolean" },
            "fed_day": { "type": "boolean" },
            "major_macro_release": { "type": "boolean" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "instrument": {
      "type": "object",
      "required": ["identity", "price", "performance"],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["ticker", "name", "exchange", "currency"],
          "properties": {
            "ticker": { "type": "string" },
            "isin": { "type": "string" },
            "cusip": { "type": "string" },
            "name": { "type": "string" },
            "exchange": { "type": "string" },
            "currency": { "type": "string" },
            "sector": { "type": "string" },
            "industry": { "type": "string" },
            "sub_industry": { "type": "string" },
            "country_of_domicile": { "type": "string" },
            "index_memberships": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["index_name"],
                "properties": {
                  "index_name": { "type": "string" },
                  "weight": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },

        "price": {
          "type": "object",
          "required": ["last"],
          "properties": {
            "last": { "type": "number" },
            "open": { "type": "number" },
            "high": { "type": "number" },
            "low": { "type": "number" },
            "close_prev": { "type": "number" },
            "market_cap": { "type": "number" },
            "enterprise_value": { "type": "number" },
            "shares_outstanding": { "type": "number" },
            "free_float": { "type": "number" }
          },
          "additionalProperties": false
        },

        "performance": {
          "type": "object",
          "properties": {
            "returns": {
              "type": "object",
              "properties": {
                "1d": {
                  "type": "object",
                  "properties": {
                    "price_return": { "type": "number" },
                    "total_return": { "type": "number" },
                    "vs_index": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "5d": { "$ref": "#/definitions/ReturnHorizon" },
                "1m": { "$ref": "#/definitions/ReturnHorizon" },
                "3m": { "$ref": "#/definitions/ReturnHorizon" },
                "6m": { "$ref": "#/definitions/ReturnHorizon" },
                "1y": { "$ref": "#/definitions/ReturnHorizon" },
                "3y": { "$ref": "#/definitions/ReturnHorizon" },
                "5y": { "$ref": "#/definitions/ReturnHorizon" },
                "10y": { "$ref": "#/definitions/ReturnHorizon" }
              },
              "additionalProperties": false
            },
            "max_drawdown": {
              "type": "object",
              "properties": {
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" },
                "3y": { "type": "number" },
                "5y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "price_regime": {
              "type": "string",
              "enum": ["uptrend", "downtrend", "range", "unknown"]
            }
          },
          "additionalProperties": false
        },

        "volatility": {
          "type": "object",
          "properties": {
            "realized_vol": {
              "type": "object",
              "properties": {
                "10d": { "type": "number" },
                "20d": { "type": "number" },
                "60d": { "type": "number" },
                "250d": { "type": "number" }
              },
              "additionalProperties": false
            },
            "rel_vol_vs_index": {
              "type": "object",
              "properties": {
                "10d": { "type": "number" },
                "20d": { "type": "number" },
                "60d": { "type": "number" },
                "250d": { "type": "number" }
              },
              "additionalProperties": false
            },
            "return_distribution": {
              "type": "object",
              "properties": {
                "skewness": { "type": "number" },
                "kurtosis": { "type": "number" },
                "tail_events_up": { "type": "integer" },
                "tail_events_down": { "type": "integer" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "liquidity": {
          "type": "object",
          "properties": {
            "avg_volume": {
              "type": "object",
              "properties": {
                "1d": { "type": "number" },
                "5d": { "type": "number" },
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "avg_dollar_volume": {
              "type": "object",
              "properties": {
                "1d": { "type": "number" },
                "5d": { "type": "number" },
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "turnover": {
              "type": "object",
              "properties": {
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "bid_ask_spread": {
              "type": "object",
              "properties": {
                "absolute": { "type": "number" },
                "bp": { "type": "number" }
              },
              "additionalProperties": false
            },
            "orderbook_depth": {
              "type": "object",
              "properties": {
                "top_of_book": {
                  "type": "object",
                  "properties": {
                    "volume_bid": { "type": "number" },
                    "volume_ask": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "depth_5_levels": { "type": "number" },
                "depth_10_levels": { "type": "number" }
              },
              "additionalProperties": false
            },
            "execution_quality": {
              "type": "object",
              "properties": {
                "avg_slippage_vs_mid": { "type": "number" },
                "pct_trades_at_bid": { "type": "number" },
                "pct_trades_at_ask": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "derivatives": {
          "type": "object",
          "properties": {
            "iv": {
              "type": "object",
              "properties": {
                "1w": {
                  "type": "object",
                  "properties": {
                    "atm": { "type": "number" },
                    "calls_otm_10": { "type": "number" },
                    "puts_otm_10": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "1m": { "$ref": "#/definitions/IVHorizon" },
                "3m": { "$ref": "#/definitions/IVHorizon" }
              },
              "additionalProperties": false
            },
            "skew": {
              "type": "object",
              "properties": {
                "1w": { "type": "number" },
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "percentile_vs_history": { "type": "number" }
              },
              "additionalProperties": false
            },
            "options_flow": {
              "type": "object",
              "properties": {
                "oi_calls": { "type": "number" },
                "oi_puts": { "type": "number" },
                "put_call_ratio_volume": { "type": "number" },
                "put_call_ratio_oi": { "type": "number" },
                "top_strikes_by_oi": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "strike": { "type": "number" },
                      "type": { "type": "string", "enum": ["call", "put"] },
                      "oi": { "type": "number" },
                      "expiry": { "type": "string", "format": "date" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "gamma_exposure": {
              "type": "object",
              "properties": {
                "total": { "type": "number" },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "short_interest": {
          "type": "object",
          "properties": {
            "shares": { "type": "number" },
            "float_pct": { "type": "number" },
            "days_to_cover": { "type": "number" },
            "borrow_rate": { "type": "number" },
            "trend": {
              "type": "object",
              "properties": {
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "dividends": {
          "type": "object",
          "properties": {
            "yield": { "type": "number" },
            "payout_ratio": { "type": "number" },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": { "type": "string", "format": "date" },
                  "amount": { "type": "number" },
                  "currency": { "type": "string" },
                  "growth_vs_prev": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "company": {
      "type": "object",
      "required": ["profile", "financials", "valuation"],
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "legal_name": { "type": "string" },
            "headquarters_location": { "type": "string" },
            "incorporation_country": { "type": "string" },
            "business_description": { "type": "string" },
            "revenue_by_segment": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "segment_name": { "type": "string" },
                  "revenue_pct": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "revenue_by_geography": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "region": { "type": "string" },
                  "revenue_pct": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "business_model_tags": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },

        "management": {
          "type": "object",
          "properties": {
            "ceo": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "age": { "type": "integer" },
                "since": { "type": "string", "format": "date" }
              },
              "additionalProperties": false
            },
            "cfo": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "since": { "type": "string", "format": "date" }
              },
              "additionalProperties": false
            },
            "c_suite_avg_tenure": { "type": "number" },
            "performance_since_ceo": { "type": "number" }
          },
          "additionalProperties": false
        },

        "governance": {
          "type": "object",
          "properties": {
            "board_size": { "type": "integer" },
            "independent_directors_pct": { "type": "number" },
            "dual_class_shares": { "type": "boolean" },
            "compensation_policy": {
              "type": "object",
              "properties": {
                "fixed_pct": { "type": "number" },
                "variable_pct": { "type": "number" },
                "equity_pct": { "type": "number" }
              },
              "additionalProperties": false
            },
            "legal_cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": { "type": "integer" },
                  "type": { "type": "string" },
                  "amount": { "type": "number" },
                  "status": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "governance_flags": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },

        "ownership": {
          "type": "object",
          "properties": {
            "insider_ownership_pct": { "type": "number" },
            "key_insiders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                    "role": { "type": "string" },
                    "ownership_pct": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "insider_activity": {
              "type": "object",
              "properties": {
                "1w": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "1m": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "3m": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "6m": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "1y": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "2y": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "5y": { "$ref": "#/definitions/InsiderActivityHorizon" },
                "10y": { "$ref": "#/definitions/InsiderActivityHorizon" }
              },
              "additionalProperties": false
            },
            "institutional_holders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "ownership_pct": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "etf_index_ownership_pct": { "type": "number" },
            "ownership_concentration": {
              "type": "object",
              "properties": {
                "top10_pct": { "type": "number" },
                "top20_pct": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "financials": {
          "type": "object",
          "properties": {
            "income_statement": {
              "type": "object",
              "properties": {
                "annual": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/IncomeStatementPeriod" }
                },
                "quarterly": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/IncomeStatementPeriod" }
                }
              },
              "additionalProperties": false
            },
            "balance_sheet": {
              "type": "object",
              "properties": {
                "annual": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/BalanceSheetPeriod" }
                },
                "quarterly": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/BalanceSheetPeriod" }
                }
              },
              "additionalProperties": false
            },
            "cash_flow": {
              "type": "object",
              "properties": {
                "annual": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/CashFlowPeriod" }
                },
                "quarterly": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/CashFlowPeriod" }
                }
              },
              "additionalProperties": false
            },
            "profitability": {
              "type": "object",
              "properties": {
                "roe_ttm": { "type": "number" },
                "roa_ttm": { "type": "number" },
                "roic_ttm": { "type": "number" },
                "roe_avg_5y": { "type": "number" },
                "roic_minus_wacc": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "capital_allocation": {
          "type": "object",
          "properties": {
            "dividend_policy": { "type": "string" },
            "buybacks_history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": { "type": "integer" },
                  "amount": { "type": "number" },
                  "shares_reduced_pct": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "mna_history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "deal_name": { "type": "string" },
                  "year": { "type": "integer" },
                  "size": { "type": "number" },
                  "type": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "capital_allocation_priorities": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },

        "valuation": {
          "type": "object",
          "properties": {
            "multiples": {
              "type": "object",
              "properties": {
                "pe_ttm": { "type": "number" },
                "pe_forward": { "type": "number" },
                "peg": { "type": "number" },
                "ev_to_ebitda": { "type": "number" },
                "ev_to_sales": { "type": "number" },
                "price_to_sales": { "type": "number" },
                "price_to_book": { "type": "number" },
                "fcf_yield": { "type": "number" },
                "earnings_yield": { "type": "number" }
              },
              "additionalProperties": false
            },
            "history": {
              "type": "object",
              "properties": {
                "pe_percentile_5y": { "type": "number" },
                "pe_percentile_10y": { "type": "number" },
                "pb_percentile_5y": { "type": "number" },
                "ev_ebitda_percentile_5y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "relative": {
              "type": "object",
              "properties": {
                "premium_discount_pe_vs_sector": { "type": "number" },
                "premium_discount_ev_ebitda_vs_sector": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "analysts": {
          "type": "object",
          "properties": {
            "coverage_count": { "type": "integer" },
            "consensus_estimates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "period": { "type": "string" },
                  "revenue": { "type": "number" },
                  "eps": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "estimate_revisions": {
              "type": "object",
              "properties": {
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" }
              },
              "additionalProperties": false
            },
            "target_price": {
              "type": "object",
              "properties": {
                "mean": { "type": "number" },
                "median": { "type": "number" },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "implied_upside_pct": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "esg": {
          "type": "object",
          "properties": {
            "score_e": { "type": "number" },
            "score_s": { "type": "number" },
            "score_g": { "type": "number" },
            "score_overall": { "type": "number" },
            "controversies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": { "type": "integer" },
                  "type": { "type": "string" },
                  "severity": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "reputation_flags": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "sector": {
      "type": "object",
      "properties": {
        "peer_universe": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ticker": { "type": "string" },
              "name": { "type": "string" },
              "sector": { "type": "string" },
              "industry": { "type": "string" },
              "country": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "sector_aggregates": {
          "type": "object",
          "properties": {
            "performance": {
              "type": "object",
              "properties": {
                "1m": { "type": "number" },
                "3m": { "type": "number" },
                "6m": { "type": "number" },
                "1y": { "type": "number" },
                "3y": { "type": "number" },
                "5y": { "type": "number" }
              },
              "additionalProperties": false
            },
            "fundamentals": {
              "type": "object",
              "properties": {
                "revenue_growth_mean": { "type": "number" },
                "margin_mean": { "type": "number" },
                "leverage_mean": { "type": "number" },
                "roe_mean": { "type": "number" },
                "roic_mean": { "type": "number" },
                "pct_profitable": { "type": "number" }
              },
              "additionalProperties": false
            },
            "valuation": {
              "type": "object",
              "properties": {
                "pe_mean": { "type": "number" },
                "pe_median": { "type": "number" },
                "ev_ebitda_mean": { "type": "number" },
                "ps_mean": { "type": "number" },
                "pb_mean": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "company_relative": {
          "type": "object",
          "properties": {
            "growth_rank": { "type": "integer" },
            "margin_rank": { "type": "integer" },
            "leverage_rank": { "type": "integer" },
            "valuation_rank": { "type": "integer" },
            "quality_rank": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "sector_sentiment": {
          "type": "object",
          "properties": {
            "news_sentiment_24h": { "type": "number" },
            "news_sentiment_7d": { "type": "number" },
            "news_sentiment_30d": { "type": "number" },
            "news_volume_7d": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "sector_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sector_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "theme": { "type": "string" },
              "exposure_level": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "market": {
      "type": "object",
      "properties": {
