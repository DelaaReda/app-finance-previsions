#!/usr/bin/env bash
set -euo pipefail

[ "${BYPASS_GUARDS:-0}" = "1" ] && echo "⚠️  Git guards bypassed (BYPASS_GUARDS=1)" && exit 0

echo "🔎 pre-commit: running local quality guards..."

# Only inspect staged files
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged_files" ] && exit 0

# Block obvious placeholder / junk markers
blocked_regex='(TODO\(agent\)|FIXME|(^|[^[:alnum:]_])XXX([^[:alnum:]_]|$)|TEMPORARY_HACK|console\.log\("debug"\)|\[WIP\]|WIP:)'
if echo "$staged_files" | grep -E '\.(py|js|ts|tsx|sh)$' >/dev/null; then
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if git show ":$f" | grep -En "$blocked_regex" >/dev/null 2>&1; then
      echo "❌ Blocked: '$f' contains WIP/TODO/FIXME/debug markers"
      echo "   Remove placeholders before commit (or BYPASS_GUARDS=1 for emergency)."
      exit 1
    fi
  done <<< "$(echo "$staged_files" | grep -E '\.(py|js|ts|tsx|sh)$' || true)"
fi

# Block edits in legacy zones unless explicitly allowed
legacy_touched="$(echo "$staged_files" | grep -E '^(legacy/|copilot-app/backend/legacy-archive/)' || true)"
if [ -n "$legacy_touched" ] && [ "${ALLOW_LEGACY_EDIT:-0}" != "1" ]; then
  echo "❌ Legacy files modified. This is blocked by default."
  echo "   Files:"
  echo "$legacy_touched" | sed 's/^/   - /'
  echo "   If intentional, rerun with ALLOW_LEGACY_EDIT=1 and reference a ticket in commit message."
  exit 1
fi

# Python syntax check on staged python files
py_files="$(echo "$staged_files" | grep -E '\.py$' || true)"
if [ -n "$py_files" ]; then
  echo "🐍 pre-commit: python syntax check"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    python3 -m py_compile "$f"
done <<< "$py_files"
fi

# JavaScript syntax check on staged JS files
js_files="$(echo "$staged_files" | grep -E '\.(js|mjs|cjs)$' || true)"
if [ -n "$js_files" ] && command -v node >/dev/null 2>&1; then
  echo "🟨 pre-commit: javascript syntax check"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    node --check "$f"
  done <<< "$js_files"
fi

# JSON schema sanity on staged JSON files
json_files="$(echo "$staged_files" | grep -E '\.json$' || true)"
if [ -n "$json_files" ]; then
  echo "🧾 pre-commit: json parse check"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    python3 -m json.tool "$f" >/dev/null
  done <<< "$json_files"
fi

# Shell syntax check on staged shell scripts
sh_files="$(echo "$staged_files" | grep -E '\.sh$' || true)"
if [ -n "$sh_files" ]; then
  echo "🐚 pre-commit: shell syntax check"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    bash -n "$f"
  done <<< "$sh_files"
fi

echo "✅ pre-commit passed"
