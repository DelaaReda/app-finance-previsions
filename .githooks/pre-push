#!/usr/bin/env bash
# Git pre-push hook - blocks push if basic quality + smoke checks fail
# Implements wait loop (no timeout command) for macOS compatibility

set -euo pipefail

[ "${BYPASS_GUARDS:-0}" = "1" ] && echo "⚠️  Push guards bypassed (BYPASS_GUARDS=1)" && exit 0

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo "❌ Direct push to $current_branch is blocked. Push from a feature branch."
  exit 1
fi

echo "🧪 Running pre-push guards..."

# Ensure workspace is clean enough (no unstaged changes) to avoid pushing accidental state
if ! git diff --quiet; then
  echo "❌ Unstaged changes detected. Commit or stash before push."
  exit 1
fi

# Wait for backend if needed (wait loop - no timeout command for macOS)
echo "⏳ Waiting for backend health check (/api/health)..."
max_attempts=15  # Max 30 seconds (15 attempts * 2s each)
attempt=1

while [ $attempt -le $max_attempts ]; do
    if curl -fsS "http://localhost:8050/api/health" >/dev/null 2>&1; then
        echo "✅ Backend is healthy"
        break
    fi

    if [ $attempt -eq $max_attempts ]; then
        echo "❌ Backend did not become healthy within 30 seconds"
        echo "💡 Make sure backend is running: ./finance-copilot.sh start"
        exit 1
    fi

    echo "⏳ Backend not ready, waiting... ($attempt/$max_attempts)"
    sleep 2
    attempt=$((attempt + 1))
done

# Run smoke test
./scripts/smoke.sh

echo "✅ All pre-push guards passed - proceeding with push"
