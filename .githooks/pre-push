#!/usr/bin/env bash
# Git pre-push hook - blocks push if basic quality + smoke checks fail

set -euo pipefail

[ "${BYPASS_GUARDS:-0}" = "1" ] && echo "⚠️  Push guards bypassed (BYPASS_GUARDS=1)" && exit 0

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo "❌ Direct push to $current_branch is blocked. Push from a feature branch."
  exit 1
fi

echo "🧪 Running pre-push guards..."

# Collect outgoing changed files from the push refs provided on stdin.
collect_changed_files() {
  local local_ref local_sha remote_ref remote_sha range
  local zero_sha="0000000000000000000000000000000000000000"

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero_sha" ] && continue
    if [ "${remote_sha:-$zero_sha}" = "$zero_sha" ]; then
      git diff-tree --no-commit-id --name-only -r "$local_sha"
    else
      range="${remote_sha}..${local_sha}"
      git diff --name-only "$range"
    fi
  done | sort -u
}

changed_files="$(collect_changed_files)"
if [ -z "$changed_files" ]; then
  changed_files="$(git diff --name-only @{push}..HEAD 2>/dev/null || true)"
fi
if [ -z "$changed_files" ]; then
  changed_files="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || true)"
fi

# Ignore live-generated runtime/state artifacts that may legitimately drift
# during a push, but still block on real unstaged source/doc changes.
unstaged_files="$(git diff --name-only || true)"
significant_unstaged="$(
  printf '%s\n' "$unstaged_files" | grep -Ev '^$|^docs/operations/orchestrator/legacy/planner-subagents-(events\.jsonl|registry\.json)$|^docs/operations/orchestrator/(parallel-workstreams|priority-queue)\.json$|^docs/operations/orchestrator/executors-monitoring-latest\.json$|^docs/operations/orchestrator/kpi-history\.jsonl$|^docs/operations/ops/DIRECTIVE_BUS\.jsonl$|^docs/ops/AGENT_MESSAGE_BUS\.jsonl$|^memory/[0-9]{4}-[0-9]{2}-[0-9]{2}\.md$|^memory/agents/.*\.md$' || true
)"
if [ -n "$significant_unstaged" ]; then
  echo "❌ Unstaged significant changes detected. Commit or stash before push."
  echo "$significant_unstaged" | sed 's/^/   - /'
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
RUNTIME_HOST_CHECK="${ROOT}/scripts/runtime_host_check.sh"
HEALTH_URL="${FC_PRE_PUSH_HEALTH_URL:-http://127.0.0.1:8050/api/health}"
HEALTH_CONNECT_TIMEOUT="${FC_PRE_PUSH_HEALTH_CONNECT_TIMEOUT:-1}"
HEALTH_MAX_TIME="${FC_PRE_PUSH_HEALTH_MAX_TIME:-2}"

run_pytest_group() {
  local label="$1"
  shift
  [ "$#" -eq 0 ] && return 0
  echo "🧪 pre-push: pytest ${label}"
  python3 -m pytest -q "$@"
}

run_static_checks() {
  local py_files js_files json_files sh_files f
  py_files="$(printf '%s\n' "$changed_files" | grep -E '\.py$' || true)"
  if [ -n "$py_files" ]; then
    echo "🐍 pre-push: python syntax check"
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      python3 -m py_compile "$f"
    done <<< "$py_files"
  fi

  js_files="$(printf '%s\n' "$changed_files" | grep -E '\.(js|mjs|cjs)$' || true)"
  if [ -n "$js_files" ] && command -v node >/dev/null 2>&1; then
    echo "🟨 pre-push: javascript syntax check"
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      node --check "$f"
    done <<< "$js_files"
  fi

  json_files="$(printf '%s\n' "$changed_files" | grep -E '\.json$' || true)"
  if [ -n "$json_files" ]; then
    echo "🧾 pre-push: json parse check"
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      python3 -m json.tool "$f" >/dev/null
    done <<< "$json_files"
  fi

  sh_files="$(printf '%s\n' "$changed_files" | grep -E '\.sh$' || true)"
  if [ -n "$sh_files" ]; then
    echo "🐚 pre-push: shell syntax check"
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      bash -n "$f"
    done <<< "$sh_files"
  fi
}

run_targeted_tests() {
  local -a tests

  if printf '%s\n' "$changed_files" | grep -Eq '^platform/automation/(compat/projections/parallel_workstream\.py|runtime/planner/|runtime/truth/|state_reconciler\.py|fc_doctor\.py|doctor\.py)'; then
    tests=()
    [ -f "${ROOT}/platform/automation/tests/test_parallel_workstream_queue_sync.py" ] && tests+=("${ROOT}/platform/automation/tests/test_parallel_workstream_queue_sync.py")
    [ -f "${ROOT}/platform/automation/tests/test_planner_autonomy_tick.py" ] && tests+=("${ROOT}/platform/automation/tests/test_planner_autonomy_tick.py")
    [ -f "${ROOT}/platform/automation/tests/test_planner_subagent_manager.py" ] && tests+=("${ROOT}/platform/automation/tests/test_planner_subagent_manager.py")
    [ -f "${ROOT}/platform/automation/tests/test_fc_doctor.py" ] && tests+=("${ROOT}/platform/automation/tests/test_fc_doctor.py")
    run_pytest_group "planner-runtime" "${tests[@]}"
  fi

  if printf '%s\n' "$changed_files" | grep -Eq '^apps/monitor/'; then
    tests=()
    [ -f "${ROOT}/apps/monitor/tests/test_status_event_store_fallback.py" ] && tests+=("${ROOT}/apps/monitor/tests/test_status_event_store_fallback.py")
    [ -f "${ROOT}/apps/monitor/tests/test_status_never_null.py" ] && tests+=("${ROOT}/apps/monitor/tests/test_status_never_null.py")
    run_pytest_group "monitor" "${tests[@]}"
  fi

  if printf '%s\n' "$changed_files" | grep -Eq '^apps/api/src/domains/(copilot|judge|market_data)/'; then
    tests=()
    [ -f "${ROOT}/apps/api/src/domains/copilot/tests/test_personal_finance_copilot_start.py" ] && tests+=("${ROOT}/apps/api/src/domains/copilot/tests/test_personal_finance_copilot_start.py")
    [ -f "${ROOT}/apps/api/src/domains/copilot/tests/test_dev03_brief_of_day_delivery.py" ] && tests+=("${ROOT}/apps/api/src/domains/copilot/tests/test_dev03_brief_of_day_delivery.py")
    [ -f "${ROOT}/apps/api/src/domains/judge/tests/test_execution_cost_estimation.py" ] && tests+=("${ROOT}/apps/api/src/domains/judge/tests/test_execution_cost_estimation.py")
    run_pytest_group "api-domains" "${tests[@]}"
  fi
}

if [ -x "$RUNTIME_HOST_CHECK" ] && ! "$RUNTIME_HOST_CHECK" | grep -q '^runtime_is_vm=1$'; then
  echo "ℹ️  Non-VM host detected; skipping runtime pre-push guards"
  exit 0
fi

run_static_checks
run_targeted_tests

echo "⏳ Waiting for backend health check (${HEALTH_URL})..."
max_attempts="${FC_PRE_PUSH_HEALTH_ATTEMPTS:-15}"  # Max 30 seconds by default (15 attempts * 2s each)
attempt=1

while [ $attempt -le $max_attempts ]; do
    if curl -fsS --connect-timeout "$HEALTH_CONNECT_TIMEOUT" --max-time "$HEALTH_MAX_TIME" "$HEALTH_URL" >/dev/null 2>&1; then
        echo "✅ Backend is healthy"
        break
    fi

    if [ $attempt -eq $max_attempts ]; then
        echo "ℹ️  Backend not healthy locally; skipping integration smoke after offline guards"
        exit 0
    fi

    echo "⏳ Backend not ready, waiting... ($attempt/$max_attempts)"
    sleep 2
    attempt=$((attempt + 1))
done

# Run smoke test
"${ROOT}/scripts/smoke.sh"

echo "✅ All pre-push guards passed - proceeding with push"
