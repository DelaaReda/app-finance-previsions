# 🌐 Environment Configuration for Finance Copilot
# Complete setup addressing inspector's concern about missing 20+ variables

# === CORE API CONFIGURATION ===
API_HOST=127.0.0.1
API_PORT=8050
API_ENV=development  # development | production

# === DATA SOURCES ===
# FRED API (Federal Reserve Economic Data)
FRED_API_KEY=YOUR_FRED_API_KEY_HERE  # Get from https://fred.stlouisfed.org/docs/api/api_key.html

# Yahoo Finance (via yfinance)
AF_ALLOW_INTERNET=1  # Allow internet access for live data

# === LLM CONFIGURATION (CRITICAL FOR COPILOT) ===
# OpenAI Compatible Provider
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE  # sk-... or leave empty for G4F free tier
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Alternative Free Provider (G4F - No Auth Required)
G4F_PROVIDER=DeepInfra  # DeepInfra | HuggingFace | Together
G4F_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo  # Powerful free model

# === DATABASE & STORAGE ===
# For RAG store scaling (SQLite initially, then PostgreSQL)
DATABASE_URL=sqlite:///data/rag/rag_database.db  # SQLite for MVP
# DATABASE_URL=postgresql://user:pass@localhost:5432/finance_copilot  # For production

# Cache Configuration
REDIS_URL=redis://localhost:6379/0  # Optional Redis cache
CACHE_TTL_HOURS=24

# === SECURITY ===
# Session secrets
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# === RATE LIMITING ===
RATE_LIMIT_COPILOT=10/minute  # Prevent abuse of expensive LLM calls
RATE_LIMIT_BRIEF=30/hour      # Prevent abuse of scoring
RATE_LIMIT_NEWS=100/hour      # Prevent abuse of news feed

# === THIRD-PARTY SERVICES ===
# Finnhub (for peer analysis and extended stock data)
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE  # Optional

# News API (alternative news sources)
NEWSAPI_ORG_KEY=YOUR_NEWSAPI_KEY_HERE  # Optional

# === LOGGING & MONITORING ===
LOG_LEVEL=INFO
LOGURU_LEVEL=INFO
LOGURU_SINK=logs/api.log
SENTRY_DSN=  # Optional Sentry monitoring

# === PERFORMANCE OPTIMIZATION ===
# Downsample thresholds
DOWNSAMPLE_THRESHOLD_POINTS=1000  # Max points for charts

# RAG Configuration
RAG_NEWS_RETENTION_DAYS=730  # Keep 2 years of news
RAG_FACTS_RETENTION_DAYS=1825  # Keep 5 years of facts

# === DEVELOPMENT ===
# Debug mode
DEBUG=false
RELOAD=true  # Auto-reload during development

# === PRODUCTION ===
# Production optimizations
WORKERS=4  # Uvicorn workers
TIMEOUT_KEEP_ALIVE=5  # Keep-alive timeout

# === BACKUP & MAINTENANCE ===
# Automated backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# === FEATURE FLAGS ===
# Enable/disable features
FEATURE_NEWS_INGESTION=true
FEATURE_RAG_ENRICHMENT=true
FEATURE_LLM_COPILOT=true
FEATURE_BACKTESTING=false  # Disabled by default

# === QUALITY CONTROL ===
# Data freshness requirements (from VISION.md)
NEWS_FRESHNESS_TARGET_MINUTES=10  # Target median < 10 min
DATA_COVERAGE_TARGET_PERCENT=90  # Target ≥ 90% tickers ≤ 24h

# === TESTING ===
# Test configuration
TEST_DATABASE_URL=sqlite:///:memory:  # In-memory DB for tests
TEST_API_TIMEOUT=30  # API test timeout seconds

# === MISC ===
# User-Agent for web requests
USER_AGENT=FinanceCopilot/1.0 (+https://github.com/your-org/finance-copilot)

# Timezone
TZ=UTC

# === SAMPLE VALUES FOR QUICK START ===
# To get started quickly, uncomment these:
# FRED_API_KEY=0123456789abcdef0123456789abcdef
# OPENAI_API_KEY=sk-...
# FINNHUB_API_KEY=cq0123456789abcdef01234567
# SECRET_KEY=super-secret-key-change-me-in-production

# === INSTRUCTIONS ===
# 1. Copy this file: cp .env.sample .env
# 2. Edit .env with your actual values
# 3. Never commit .env to version control
# 4. Restart the API after changes

# === REQUIRED FOR MVP ===
# At minimum, you need:
# FRED_API_KEY=your_actual_key_here
# AF_ALLOW_INTERNET=1
# OPENAI_API_KEY=your_key_or_leave_empty_for_free_tier