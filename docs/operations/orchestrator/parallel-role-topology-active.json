{
  "version": 2,
  "note": "Active roles only - managed by fc_setup_crons.sh",
  "updated_at": "2026-03-01",
  "roles": [
    {
      "role": "planner",
      "lane": "orchestration",
      "every": "15m",
      "allow_file_edits": 1,
      "wip_limit": 2,
      "description": "Planner - dispatches tasks to all roles",
      "session_name": "codex_planner_cron",
      "trace_file": "logs-codex-runs/role-runner/planner.live.log"
    },
    {
      "role": "backend_engineer",
      "lane": "build",
      "every": "20m",
      "allow_file_edits": 1,
      "wip_limit": 2,
      "description": "Backend - API, forecasts, data quality",
      "session_name": "codex_backend_engineer_cron",
      "trace_file": "logs-codex-runs/role-runner/backend_engineer.live.log"
    },
    {
      "role": "frontend_engineer",
      "lane": "build",
      "every": "20m",
      "allow_file_edits": 1,
      "wip_limit": 2,
      "description": "Frontend - UI, apiConnector, widgets",
      "session_name": "codex_frontend_engineer_cron",
      "trace_file": "logs-codex-runs/role-runner/frontend_engineer.live.log"
    },
    {
      "role": "data_analyst",
      "lane": "data",
      "every": "30m",
      "allow_file_edits": 1,
      "wip_limit": 1,
      "description": "Data - backtests, quality, metrics",
      "session_name": "codex_data_analyst_cron",
      "trace_file": "logs-codex-runs/role-runner/data_analyst.live.log"
    }
  ]
}
